      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, method, endpoint) (rate(smartmaintain_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{method}} {{endpoint}}",
          "refId": "A"
